OPENAI_API_KEY=
# Role-specific model routing. Keep these explicit in production if you want
# Vercel config to show the active routing instead of relying on code defaults.
OPENAI_INTAKE_FAST_MODEL=gpt-5.4-mini
OPENAI_INTAKE_ESCALATED_MODEL=gpt-5.4
OPENAI_PLAN_STANDARD_MODEL=gpt-5.4-mini
OPENAI_PLAN_ESCALATED_MODEL=gpt-5.4
OPENAI_EVALUATOR_FAST_MODEL=gpt-5.4-mini
OPENAI_REVISION_STANDARD_MODEL=gpt-5.4-mini
OPENAI_SAFETY_CLASSIFIER_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional, privacy-safe cost estimation. Example shape:
# {"gpt-5.4-mini":{"input_per_1m":0.75,"cached_input_per_1m":0.075,"output_per_1m":4.5}}
OPENAI_MODEL_PRICING_JSON=
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
NEXT_PUBLIC_FLOWPATH_COGNITIVE_DEBUG=false

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_PROXY_URL=
FLOWPATH_OWNER_EMAIL=
INTERNAL_UNLIMITED_EMAILS=

# Local development can use file:./data/flowpath.db. For production, set
# DATABASE_URL to the Turso/libSQL URL in Vercel and provide TURSO_AUTH_TOKEN.
DATABASE_URL=file:./data/flowpath.db
TURSO_AUTH_TOKEN=
APP_TIMEZONE=America/New_York

# Stripe billing. Use test-mode keys locally and live-mode keys only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_MONTHLY_PRICE_ID=
APP_URL=http://localhost:3000
# Optional overrides. If blank/omitted, FlowPath derives these from APP_URL.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
