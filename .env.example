OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CLASSIFIER_MODEL=
OPENAI_MEMORY_MODEL=
OPENAI_GENERATOR_MODEL=
OPENAI_ESCALATION_MODEL=
OPENAI_EVALUATOR_MODEL=
OPENAI_EXTRACTION_MODEL=
# Optional role-specific overrides. If omitted, FlowPath uses cost-aware defaults from src/lib/model-routing.ts.
OPENAI_INTAKE_FAST_MODEL=
OPENAI_INTAKE_ESCALATED_MODEL=
OPENAI_PLAN_STANDARD_MODEL=
OPENAI_PLAN_ESCALATED_MODEL=
OPENAI_EVALUATOR_FAST_MODEL=
OPENAI_REVISION_STANDARD_MODEL=
OPENAI_SAFETY_CLASSIFIER_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
# Optional, privacy-safe cost estimation. Example shape:
# {"gpt-5.4-mini":{"input_per_1m":0.75,"cached_input_per_1m":0.075,"output_per_1m":4.5}}
OPENAI_MODEL_PRICING_JSON=
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
NEXT_PUBLIC_FLOWPATH_COGNITIVE_DEBUG=false

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_PROXY_URL=
FLOWPATH_OWNER_EMAIL=
INTERNAL_UNLIMITED_EMAILS=

# Local development defaults to file:./data/flowpath.db if DATABASE_URL is omitted.
# For Turso/libSQL production, use a libsql:// URL and auth token.
# DATABASE_URL=file:./data/flowpath.db
# TURSO_AUTH_TOKEN=
# Used as a rough timezone hint for local web search. Put city/region/country in Memory/Profile.
# APP_TIMEZONE=America/New_York

# Stripe billing. Use test-mode keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CORE_MONTHLY_PRICE_ID=
APP_URL=http://localhost:3000
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
