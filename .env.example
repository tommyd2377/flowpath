OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_PROXY_URL=
FLOWPATH_OWNER_EMAIL=

# Local development defaults to file:./data/flowpath.db if DATABASE_URL is omitted.
# For Turso/libSQL production, use a libsql:// URL and auth token.
# DATABASE_URL=file:./data/flowpath.db
# TURSO_AUTH_TOKEN=
# Used as a rough timezone hint for local web search. Put city/region/country in Memory/Profile.
# APP_TIMEZONE=America/New_York
