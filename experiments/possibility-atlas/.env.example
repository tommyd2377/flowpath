# Server-only. Copy to .env.local and provide your own key when you are ready.
OPENAI_API_KEY=
POSSIBILITY_ATLAS_OPENAI_MODEL=gpt-5.6-terra
POSSIBILITY_ATLAS_OPENAI_ENABLED=0

# Isolated local catalog. This never reads FlowPath's database configuration.
POSSIBILITY_ATLAS_DATABASE_URL=file:./data/possibility-atlas.db

# Development-only deterministic responses. Never presented as live analysis.
POSSIBILITY_ATLAS_FIXTURE_MODE=0
