{
  "name": "flowpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "evals": "tsx src/lib/evals/run-evals.ts",
    "evals:offline": "tsx src/lib/evals/run-evals.ts --offline",
    "evals:live": "FLOWPATH_LIVE_EVALS=1 tsx src/lib/evals/run-evals.ts --live",
    "evals:live:compare": "FLOWPATH_LIVE_EVALS=1 tsx src/lib/evals/run-evals.ts --live-compare",
    "generation:report": "tsx scripts/flowpath-generation-report.ts",
    "db:init": "node scripts/init-db.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.4",
    "@libsql/client": "^0.17.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
